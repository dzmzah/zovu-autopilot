.env
node_modules/
out/
bg-gen/
bg-photo/
*.tmp
stats.json

# рабочие папки движка рилс-кейсов
klatki/
zrzuty/
*.mp4

# рилсы на выкладку лежат в репозитории: Meta забирает их по прямой ссылке
!rolki/*.mp4

# Кладовая своих съёмок. Сборка идёт на сервере и берёт их оттуда же,
# откуда broll: без них сборщик падает на первом же куске.
!wlasne/*.mp4
